<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Sukut.Launch" parent="Theme.CleanWave">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
    <style name="Theme.CleanWave" parent="android:style/Theme.DeviceDefault">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
    </style>
    <style name="Theme.CleanWave.Light" parent="android:style/Theme.DeviceDefault.Light">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Theme.CleanWave.Dark" parent="android:style/Theme.DeviceDefault">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
