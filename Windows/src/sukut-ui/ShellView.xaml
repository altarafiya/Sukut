       <Path Data="M40,17 H46 L40,23 H46" Stroke="{ThemeResource SukutAccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
