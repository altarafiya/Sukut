    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
    <StackPanel Spacing="6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8"><FontIcon Glyph="&#xE737;" FontSize="16"/><TextBlock Loaded="Typography_Loaded" x:Name="OutputSourceAppTitle" Text="Source app" FontWeight="SemiBold" VerticalAlignment="Center"/></StackPanel></Grid><ListView x:Name="SourceAppList" AutomationProperties.AutomationId="SourceAppList" SelectionMode="Single" Height="128" Margin="-4,0" ItemTemplate="{StaticResource SourceAppCardTemplate}" SelectionChanged="App_Changed" ScrollViewer.HorizontalScrollMode="Enabled" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollMode="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListView.ItemsPanel><ItemsPanelTemplate><ItemsStackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListView.ItemsPanel><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="2,2,2,4"/><Setter Property="MinWidth" Value="96"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="CornerRadius" Value="6"/></Style></ListView.ItemContainerStyle></ListView><TextBlock x:Name="SourceAppHint" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/></StackPanel>
    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}"/>
    <StackPanel Spacing="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><FontIcon Glyph="&#xE945;" FontSize="16"/><TextBlock Loaded="Typography_Loaded" x:Name="BufferingLabel" Text="Audio buffering" FontWeight="SemiBold"/></StackPanel></Grid><local:BufferingControl x:Name="HomeBuffering" Inline="True" ValueCommitted="Buffering_Committed" AutomationProperties.AutomationId="HomeBuffering"/></StackPanel>
   </StackPanel>
  </Border>
 </Grid>
</ScrollViewer>
    <ScrollViewer x:Name="SettingsPanel" AutomationProperties.AutomationId="SettingsPanel" x:Load="{x:Bind View.SettingsLoaded, Mode=OneWay}" Loaded="SettingsPanel_Loaded" ViewChanged="SettingsPanel_ViewChanged" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
