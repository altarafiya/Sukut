  </Grid></RadioButton><RadioButton x:Name="OptimizedCard" AutomationProperties.AutomationId="OptimizedCard" Style="{StaticResource ModeCard}" MinHeight="64" MinWidth="0" Padding="12,10" CornerRadius="6" Tag="2" AutomationProperties.Name="Optimized">
  <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Viewbox Width="20" Height="20" VerticalAlignment="Center"><FontIcon Glyph="&#xE9E9;" FontSize="20"/></Viewbox>
   <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Loaded="Typography_Loaded" x:Name="OptimizedLabel" Text="Optimized" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"/><TextBlock Loaded="Typography_Loaded" x:Name="OptimizedDescription" Text="Adjust the background level" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/></StackPanel>
  </Grid></RadioButton><RadioButton x:Name="StrictCard" AutomationProperties.AutomationId="StrictCard" Style="{StaticResource ModeCard}" MinHeight="64" MinWidth="0" Padding="12,10" CornerRadius="6" Tag="3" AutomationProperties.Name="Strict">
