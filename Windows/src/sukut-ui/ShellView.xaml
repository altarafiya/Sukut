   <NavigationView.FooterMenuItems><NavigationViewItem x:Name="HomeSettingsButton" Content="Settings" Tag="1" AutomationProperties.AutomationId="HomeSettingsButton"><NavigationViewItem.Icon><FontIcon Glyph="&#xE713;"/></NavigationViewItem.Icon></NavigationViewItem></NavigationView.FooterMenuItems>
