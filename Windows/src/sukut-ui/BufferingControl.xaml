<UserControl x:Class="Sukut.BufferingControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Sukut">
 <UserControl.Resources>
  <Style x:Key="BufferCard" TargetType="RadioButton" BasedOn="{StaticResource ModeCard}">
   <Setter Property="Padding" Value="8" />
   <Setter Property="MinHeight" Value="74" />
   <Setter Property="MinWidth" Value="0" />
   <Setter Property="Width" Value="124" />
  </Style>
 </UserControl.Resources>
 <Border x:Name="Frame" Padding="16" CornerRadius="12" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
  <StackPanel x:Name="ContentStack" Spacing="12">
   <TextBlock Loaded="Typography_Loaded" x:Name="Heading" HorizontalAlignment="Center" Foreground="{ThemeResource ModeOptimizedBrush}" Style="{StaticResource BodyStrongTextBlockStyle}"/>
   <Grid x:Name="Options" ColumnSpacing="8" HorizontalAlignment="Center">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <RadioButton x:Name="LowestChoice" Grid.Column="0" Style="{StaticResource BufferCard}" Background="{ThemeResource ModeHalalWash}" BorderBrush="{ThemeResource ModeHalalBrush}" Foreground="{ThemeResource ModeHalalBrush}" AutomationProperties.AutomationId="BufferLowest" Checked="Choice_Checked"><StackPanel Spacing="6" HorizontalAlignment="Center"><FontIcon Glyph="&#xE945;" FontSize="22" HorizontalAlignment="Center" Foreground="{ThemeResource ModeHalalBrush}"/><TextBlock Loaded="Typography_Loaded" x:Name="Lowest" Padding="4,2,6,2" Text="Lowest" Foreground="{ThemeResource ModeHalalBrush}" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"/></StackPanel></RadioButton>
    <RadioButton x:Name="BalancedChoice" Grid.Column="1" Style="{StaticResource BufferCard}" Background="{ThemeResource ModeOptimizedWash}" BorderBrush="{ThemeResource ModeOptimizedBrush}" Foreground="{ThemeResource ModeOptimizedBrush}" AutomationProperties.AutomationId="BufferBalanced" Checked="Choice_Checked"><StackPanel Spacing="6" HorizontalAlignment="Center"><FontIcon Glyph="&#xE9E9;" FontSize="22" HorizontalAlignment="Center" Foreground="{ThemeResource ModeOptimizedBrush}"/><TextBlock Loaded="Typography_Loaded" x:Name="Balanced" Padding="4,2,6,2" Text="Balanced" Foreground="{ThemeResource ModeOptimizedBrush}" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"/></StackPanel></RadioButton>
    <RadioButton x:Name="MaximumChoice" Grid.Column="2" Style="{StaticResource BufferCard}" Background="{ThemeResource ModeStrictWash}" BorderBrush="{ThemeResource ModeStrictBrush}" Foreground="{ThemeResource ModeStrictBrush}" AutomationProperties.AutomationId="BufferMaximum" Checked="Choice_Checked"><StackPanel Spacing="6" HorizontalAlignment="Center"><FontIcon Glyph="&#xE823;" FontSize="22" HorizontalAlignment="Center" Foreground="{ThemeResource ModeStrictBrush}"/><TextBlock Loaded="Typography_Loaded" x:Name="Maximum" Padding="4,2,6,2" Text="Maximum" Foreground="{ThemeResource ModeStrictBrush}" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource BodyStrongTextBlockStyle}"/></StackPanel></RadioButton>
   </Grid>
   <TextBlock Loaded="Typography_Loaded" x:Name="Tip" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
  </StackPanel>
 </Border>
</UserControl>
